// ==========================================
// TB6612FNG Motor Driver Pins
// ==========================================
#define PWMA 5   // Right Motor Speed (PWM)
#define PWMB 6   // Left Motor Speed (PWM)

#define AIN1 7   // Right Motor Direction 1
#define AIN2 8   // Right Motor Direction 2

#define STBY 9   // Standby Pin (Must be HIGH)

#define BIN1 10  // Left Motor Direction 1
#define BIN2 11  // Left Motor Direction 2

#define led13 13 // Built-in LED on Arduino Uno

// ==========================================
// Side Digital LM393 Sensor Pins
// ==========================================
#define LEFT_LM393  2  // Left Side Digital Sensor
#define RIGHT_LM393 3  // Right Side Digital Sensor

// LM393 sensor එක කළු ඉර මතදී HIGH දෙනවා නම් HIGH ලෙස තබන්න (LOW නම් LOW ලෙස මාරු කරන්න)
#define LM393_LINE_STATE HIGH

// ==========================================
// 6-Sensor Analog Array Settings (A0 - A5)
// ==========================================
#define sensorNumber 6
int raw_sensor[sensorNumber];
int sensor[sensorNumber];

// S1 - S6 Threshold Values
int threshold[sensorNumber] = { 319, 152, 125, 204, 227, 293 };[cite: 2]

bool invert_line = false; // false = Black line on White | true = White line on Black
bool left_side_detected = false;
bool right_side_detected = false;

// ==========================================
// Dotted Line, Turn & Stop Settings
// ==========================================
#define turn_delay 10
#define u_turn_delay 50
#define stop_timer 30
const unsigned long dot_gap_timeout = 220;

// ==========================================
// Speed & PID Variables
// ==========================================
int max_speed = 250;
int left_motor_speed = 180;
int right_motor_speed = 180;
int turn_speed = 135;
int dot_speed = 140;

int kp = 65;
int kd = 900;

int sensor_sum;
float calculated_pos;
int PID;
int turn_value = 0;
float error, previous_error;
float center_point = 3.5;
int line_position;
unsigned long last_line_seen_time = 0;

void setup() {
  pinMode(PWMA, OUTPUT);
  pinMode(PWMB, OUTPUT);
  pinMode(AIN1, OUTPUT);
  pinMode(AIN2, OUTPUT);
  pinMode(BIN1, OUTPUT);
  pinMode(BIN2, OUTPUT);
  pinMode(STBY, OUTPUT);
  pinMode(led13, OUTPUT);

  pinMode(LEFT_LM393, INPUT);
  pinMode(RIGHT_LM393, INPUT);

  digitalWrite(STBY, HIGH);
  Serial.begin(9600);

  // ආරම්භ වීමට පෙර තත්පර 2ක් LED එක Blink වේ
  for (int i = 0; i < 4; i++) {
    digitalWrite(led13, HIGH);
    delay(250);
    digitalWrite(led13, LOW);
    delay(250);
  }

  last_line_seen_time = millis();
}

void loop() {
  Line_Follow();
}

// ==========================================
// Sensor Reading Function (6 Analog + 2 Digital)
// ==========================================
void read_sensor() {
  line_position = 0;
  sensor_sum = 0;

  int raw_state[sensorNumber];

  for (byte i = 0; i < sensorNumber; i++) {
    raw_sensor[i] = analogRead(i);
    if (raw_sensor[i] > threshold[i]) raw_state[i] = 1;
    else raw_state[i] = 0;
  }

  // කෙළවරේ analog sensors දෙක (S1 සහ S6) බලා background color තීරණය කිරීම
  if (raw_state[0] == 1 && raw_state[5] == 1) {
    invert_line = true;
    digitalWrite(led13, HIGH);
  } else if (raw_state[0] == 0 && raw_state[5] == 0) {
    invert_line = false;
    digitalWrite(led13, LOW);
  }

  for (byte i = 0; i < sensorNumber; i++) {
    if (!invert_line) {
      sensor[i] = raw_state[i];
    } else {
      sensor[i] = !raw_state[i];
    }
  }

  // Left සහ Right LM393 Digital Sensors කියවීම
  bool raw_left = (digitalRead(LEFT_LM393) == LM393_LINE_STATE);
  bool raw_right = (digitalRead(RIGHT_LM393) == LM393_LINE_STATE);

  // White line on Black background නම් digital sensors ද invert කිරීම
  if (!invert_line) {
    left_side_detected = raw_left;
    right_side_detected = raw_right;
  } else {
    left_side_detected = !raw_left;
    right_side_detected = !raw_right;
  }

  sensor_sum = (sensor[0] + sensor[1] + sensor[2] + sensor[3] + sensor[4] + sensor[5]);
  line_position = (sensor[0] * 1 + sensor[1] * 2 + sensor[2] * 3 + sensor[3] * 4 + sensor[4] * 5 + sensor[5] * 6);

  if (sensor_sum > 0) {
    calculated_pos = (float)line_position / sensor_sum;
    last_line_seen_time = millis();
  }
}

// ==========================================
// TB6612FNG Motor Control Function
// ==========================================
void motor(int left, int right) {
  // Right Motor (Channel A)
  if (right > 0) {
    digitalWrite(AIN1, HIGH);
    digitalWrite(AIN2, LOW);
  } else if (right < 0) {
    right = -right;
    digitalWrite(AIN1, LOW);
    digitalWrite(AIN2, HIGH);
  } else {
    digitalWrite(AIN1, LOW);
    digitalWrite(AIN2, LOW);
  }

  // Left Motor (Channel B)
  if (left > 0) {
    digitalWrite(BIN1, HIGH);
    digitalWrite(BIN2, LOW);
  } else if (left < 0) {
    left = -left;
    digitalWrite(BIN1, LOW);
    digitalWrite(BIN2, HIGH);
  } else {
    digitalWrite(BIN1, LOW);
    digitalWrite(BIN2, LOW);
  }

  if (left > max_speed) left = max_speed;
  if (right > max_speed) right = max_speed;

  analogWrite(PWMB, abs(left));
  analogWrite(PWMA, abs(right));
}

// ==========================================
// Main PID + Hybrid Turn Following Function
// ==========================================
void Line_Follow() {
  while (1) {
    read_sensor();

    // 1. දෙපැත්තේ LM393 sensors වලින් කල්තියා 90° Turn හඳුනා ගැනීම
    if (left_side_detected && !right_side_detected) {
      turn_value = 1; // Left Turn Priority
    } else if (right_side_detected && !left_side_detected) {
      turn_value = 2; // Right Turn Priority
    }

    // 2. මැද Analog sensors 6 මත ඉර ඇති විට සාමාන්‍ය PID ධාවනය
    if (sensor_sum > 0) {
      error = center_point - calculated_pos;
      PID = error * kp + kd * (error - previous_error);
      previous_error = error;

      int right_motor = right_motor_speed - PID;
      int left_motor = left_motor_speed + PID;

      motor(left_motor, right_motor);

      // Analog කෙළවරේ sensors වලින්ද turn direction backup ලෙස තබා ගැනීම
      if (sensor[5] == 1 && sensor[0] == 0) turn_value = 1;
      if (sensor[5] == 0 && sensor[0] == 1) turn_value = 2;
    }

    // 3. මැද sensors 6 ටම ඉර නොපෙනෙන විට (Sharp Turn / Dotted Gap / U-Turn)
    if (sensor_sum == 0) {
      if (turn_value == 1 || left_side_detected) {
        delay(turn_delay);
        motor(-turn_speed, turn_speed);
        while (sensor[3] == 0 && sensor[2] == 0) read_sensor();
        turn_value = 0;
        last_line_seen_time = millis();
      } else if (turn_value == 2 || right_side_detected) {
        delay(turn_delay);
        motor(turn_speed, -turn_speed);
        while (sensor[3] == 0 && sensor[2] == 0) read_sensor();
        turn_value = 0;
        last_line_seen_time = millis();
      } else {
        // Dotted line gap එකක් නම් ඉදිරියට යාම
        if (millis() - last_line_seen_time < dot_gap_timeout) {
          motor(dot_speed, dot_speed);
        } else {
          // සම්පූර්ණයෙන්ම ඉර අවසන් නම් U-Turn ගැනීම
          delay(u_turn_delay);
          motor(turn_speed, -turn_speed);
          while (sensor[3] == 0 && sensor[2] == 0) read_sensor();
          turn_value = 0;
          last_line_seen_time = millis();
        }
      }
    }
    // 4. සියලුම සංවේදක ඉර මත ඇති විට (End / Stop Section)
    else if (sensor_sum == 6 && left_side_detected && right_side_detected) {
      delay(stop_timer);
      read_sensor();
      if (sensor_sum == 6) {
        motor(0, 0); // STOP
        while (sensor_sum == 6) read_sensor();
      }
    }
  }
}
