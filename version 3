
/*
  8 SENSOR HYBRID PID LINE FOLLOWER
  IMPROVED BLACK LINE DETECTION

  Arduino UNO + TB6612FNG

  6 TCRT5000 Analog Sensors
  2 HW-201 Digital Sensors

  BLACK LINE / WHITE BACKGROUND

  S1 = LEFT, S6 = RIGHT
  Motor A = LEFT
  Motor B = RIGHT

  Digital BLACK = HIGH
  Digital WHITE = LOW
*/

// ===== ANALOG SENSOR PINS =====

const byte sensorPins[6] = {
  A0, A1, A2, A3, A4, A5
};

// ===== DIGITAL SENSOR PINS =====

const byte LEFT_IR = 2;
const byte RIGHT_IR = 3;

// ===== CALIBRATION VALUES =====

const int whiteValue[6] = {
  26, 28, 27, 30, 32, 30
};

const int blackValue[6] = {
  612, 275, 222, 377, 421, 555
};

// ===== REDUCED THRESHOLDS =====

const int threshold[6] = {
  260, 125, 105, 170, 190, 245
};

// ===== MOTOR DRIVER PINS =====

const byte PWMA = 5;
const byte PWMB = 6;

const byte AIN1 = 7;
const byte AIN2 = 8;

const byte STBY = 9;

const byte BIN1 = 10;
const byte BIN2 = 11;

// ===== SPEED SETTINGS =====

int baseSpeed = 85;
int minSpeed = 45;
int maxSpeed = 170;

int turnSpeed = 90;

// ===== PID SETTINGS =====

float Kp = 0.050;
float Ki = 0.0;
float Kd = 0.10;

float error = 0;
float lastError = 0;
float integral = 0;

float filteredDerivative = 0;

// ===== SENSOR VARIABLES =====

int rawValue[6];
int normalized[6];

bool analogBlack[6];

bool leftBlack = false;
bool rightBlack = false;

// ===== LINE RECOVERY =====

int lastDirection = 0;

unsigned long lineLostTime = 0;
const unsigned long recoveryLimit = 250;

// ===== SERIAL DEBUG =====

unsigned long lastPrint = 0;

// ===== MOTOR CONTROL =====

void setMotors(int left, int right) {

  left = constrain(left, -255, 255);
  right = constrain(right, -255, 255);

  // LEFT MOTOR
  if (left > 0) {
    digitalWrite(AIN1, HIGH);
    digitalWrite(AIN2, LOW);
  }
  else if (left < 0) {
    digitalWrite(AIN1, LOW);
    digitalWrite(AIN2, HIGH);
  }
  else {
    digitalWrite(AIN1, LOW);
    digitalWrite(AIN2, LOW);
  }

  // RIGHT MOTOR
  if (right > 0) {
    digitalWrite(BIN1, HIGH);
    digitalWrite(BIN2, LOW);
  }
  else if (right < 0) {
    digitalWrite(BIN1, LOW);
    digitalWrite(BIN2, HIGH);
  }
  else {
    digitalWrite(BIN1, LOW);
    digitalWrite(BIN2, LOW);
  }

  analogWrite(PWMA, abs(left));
  analogWrite(PWMB, abs(right));
}

// ===== STOP MOTORS =====

void stopMotors() {
  setMotors(0, 0);
}

// ===== READ ALL SENSORS =====

void readSensors() {

  for (int i = 0; i < 6; i++) {

    // ADC settling
    analogRead(sensorPins[i]);

    long sum = 0;

    for (int j = 0; j < 4; j++) {
      sum += analogRead(sensorPins[i]);
    }

    rawValue[i] = sum / 4;

    // Improved black detection
    analogBlack[i] =
      rawValue[i] > threshold[i];

    // Normalize readings
    normalized[i] = map(
      rawValue[i],
      whiteValue[i],
      blackValue[i],
      0,
      1000
    );

    normalized[i] = constrain(
      normalized[i],
      0,
      1000
    );
  }

  // Digital Sensors
  leftBlack =
    digitalRead(LEFT_IR) == HIGH;

  rightBlack =
    digitalRead(RIGHT_IR) == HIGH;
}

// ===== PID LINE FOLLOWING =====

void followLine() {

  long weightedSum = 0;
  long totalStrength = 0;

  int blackCount = 0;

  for (int i = 0; i < 6; i++) {

    if (analogBlack[i]) {
      blackCount++;
    }

    int strength = normalized[i];

    // Increased sensitivity
    if (strength < 60) {
      strength = 0;
    }

    weightedSum +=
      (long)strength * (i * 1000);

    totalStrength += strength;
  }

  // ===== NORMAL PID =====

  if (blackCount > 0 && totalStrength > 0) {

    lineLostTime = 0;

    float position =
      (float)weightedSum / totalStrength;

    error = position - 2500;

    // Remember last direction
    if (error < -350) {
      lastDirection = -1;
    }
    else if (error > 350) {
      lastDirection = 1;
    }

    // Derivative
    float derivative =
      error - lastError;

    // Smooth derivative
    filteredDerivative =
      0.65 * filteredDerivative +
      0.35 * derivative;

    // PID correction
    float correction =
      Kp * error +
      Ki * integral +
      Kd * filteredDerivative;

    lastError = error;

    // Reduce speed on curves
    int currentSpeed =
      baseSpeed -
      (int)(abs(error) * 0.015);

    currentSpeed = constrain(
      currentSpeed,
      minSpeed,
      baseSpeed
    );

    // Allow tight turns
    int leftSpeed = constrain(
      (int)(currentSpeed + correction),
      -maxSpeed,
      maxSpeed
    );

    int rightSpeed = constrain(
      (int)(currentSpeed - correction),
      -maxSpeed,
      maxSpeed
    );

    setMotors(leftSpeed, rightSpeed);

    return;
  }

  // ===== DIGITAL LEFT TURN =====

  if (leftBlack && !rightBlack) {

    lastDirection = -1;
    lineLostTime = 0;

    setMotors(-turnSpeed, turnSpeed);
    return;
  }

  // ===== DIGITAL RIGHT TURN =====

  if (rightBlack && !leftBlack) {

    lastDirection = 1;
    lineLostTime = 0;

    setMotors(turnSpeed, -turnSpeed);
    return;
  }

  // ===== LINE LOST RECOVERY =====

  if (lineLostTime == 0) {
    lineLostTime = millis();
  }

  if (millis() - lineLostTime < recoveryLimit) {

    if (lastDirection == -1) {
      setMotors(-65, 65);
    }
    else if (lastDirection == 1) {
      setMotors(65, -65);
    }
    else {
      stopMotors();
    }

  }
  else {
    stopMotors();
  }

  filteredDerivative = 0;
  lastError = 0;
}

// ===== SERIAL MONITOR =====

void printSensors() {

  Serial.println("===== SENSOR DATA =====");

  for (int i = 0; i < 6; i++) {

    Serial.print("S");
    Serial.print(i + 1);

    Serial.print(" RAW=");
    Serial.print(rawValue[i]);

    Serial.print(" TH=");
    Serial.print(threshold[i]);

    Serial.print(" NORM=");
    Serial.print(normalized[i]);

    Serial.print(" ");

    Serial.println(
      analogBlack[i] ? "BLACK" : "WHITE"
    );
  }

  Serial.print("DIGITAL LEFT=");
  Serial.print(leftBlack ? 1 : 0);

  Serial.print(" RIGHT=");
  Serial.println(rightBlack ? 1 : 0);

  Serial.print("PID ERROR=");
  Serial.println(error);

  Serial.print("LAST DIRECTION=");
  Serial.println(lastDirection);

  Serial.println("=======================");
}

// ===== SETUP =====

void setup() {

  Serial.begin(115200);

  pinMode(LEFT_IR, INPUT);
  pinMode(RIGHT_IR, INPUT);

  pinMode(PWMA, OUTPUT);
  pinMode(PWMB, OUTPUT);

  pinMode(AIN1, OUTPUT);
  pinMode(AIN2, OUTPUT);

  pinMode(BIN1, OUTPUT);
  pinMode(BIN2, OUTPUT);

  pinMode(STBY, OUTPUT);

  digitalWrite(STBY, HIGH);

  stopMotors();

  Serial.println(
    "HYBRID PID - HIGH SENSITIVITY READY"
  );

  delay(2000);
}

// ===== MAIN LOOP =====

void loop() {

  readSensors();

  followLine();

  if (millis() - lastPrint >= 300) {

    lastPrint = millis();

    printSensors();
  }
}
